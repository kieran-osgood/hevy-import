{
	"name": "hevy-import",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"start": "node --env-file=.env --import=tsx ./hevy-routine-import.ts",
		"start:powerlifting": "node --env-file=.env --import=tsx ./hevy-routine-import.ts --program powerlifting",
		"start:half-marathon": "node --env-file=.env --import=tsx ./hevy-routine-import.ts --program half-marathon",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"csv-parse": "^5.5.6",
		"string-similarity": "^4.0.4"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"@types/string-similarity": "^4.0.2",
		"tsx": "^4.15.0",
		"typescript": "^5.4.5"
	}
}
